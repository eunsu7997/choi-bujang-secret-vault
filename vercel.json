{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/notices",
      "destination": "/api/notes?zone=notices"
    },
    {
      "source": "/api/notices/:id",
      "destination": "/api/notes?zone=notices&id=:id"
    },
    {
      "source": "/api/admin/notices/:id",
      "destination": "/api/notes?zone=admin-notices&id=:id"
    },
    {
      "source": "/api/ops/:action",
      "destination": "/api/notes?ops=:action"
    },
    {
      "source": "/api/device/:action",
      "destination": "/api/notes?device=:action"
    },
    {
      "source": "/api/restore/:id",
      "destination": "/api/notes?zone=restore&id=:id"
    },
    {
      "source": "/api/notes/:id",
      "destination": "/api/notes?id=:id"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/notes?auth=:action"
    }
  ],
  "functions": {
    "api/notes.js": {
      "includeFiles": "{aleph.config.json,backup/policy/manifest.json}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
